# ---- Publico: acaba en el bundle del navegador (asi debe ser) ----
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_APP_NOMBRE=ADIA

# ---- Secreto: NUNCA con prefijo VITE_ ----
# Todo lo que empieza por VITE_ se incrusta como texto en el bundle y se
# publica. Estas dos variables solo las leen el proceso de node (dev server,
# scripts de migracion) y la Edge Function.
OPENAI_API_KEY=sk-proj-...
SUPABASE_BD_PASSWORD=...

# Necesario solo para desplegar la Edge Function del chat.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# Usuario administrador que siembran los scripts (opcional)
ADIA_ADMIN_EMAIL=tu@correo.com
ADIA_ADMIN_PASSWORD=CambiaEsto123!
