{
  // Comprometido a proposito: sin este archivo, el build de Cloudflare
  // auto-genera uno efimero en cada corrida (solo "assets", sin "main"), lo
  // que deja /api/chat sin manejador — cae en el binding de assets y se
  // trata como ruta de SPA. Ver src/server/chat/worker.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adia",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server/chat/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
